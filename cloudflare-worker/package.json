{
  "name": "novel-translator-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute novel-translator --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute novel-translator --local --file=./cloudflare-worker/schema.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260801.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.40.0"
  }
}
cloudflare-worker/wrangler.toml
